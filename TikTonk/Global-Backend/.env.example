# Flask configurations
SECRET_KEY=your-secret-key-here
DEBUG=False

# Server configurations
HOST=0.0.0.0
PORT=5000

# Path configurations
VIDEO_DIR=./assets/temp
FONT_PATH=./assets/font1.otf

# Video quality configuration
DEFAULT_VIDEO_QUALITY=720

# Cookie directory
COOKIE_DIR=./CookiesDir

# Logging configuration
LOG_LEVEL=INFO
LOG_FILE=app.log

# CORS configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS=*

# Rate limiting
RATE_LIMIT=100/hour
